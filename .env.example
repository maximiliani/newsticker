# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Instagram / Facebook
INSTAGRAM_CLIENT_ID=your-facebook-app-client-id
INSTAGRAM_CLIENT_SECRET=your-facebook-app-client-secret
NEXT_PUBLIC_INSTAGRAM_CLIENT_ID=your-facebook-app-client-id

# Internal shared secret for scheduled privileged API requests.
# It must match the existing INTERNAL_ADMIN_SECRET in Supabase Vault.
INTERNAL_ADMIN_SECRET=replace-with-a-strong-random-secret

# Cron setup must authenticate requests and account for Vercel Bot Protection.
# Do not place secrets in pg_net request headers until queue access is restricted.
# Verify actual HTTP responses, not just pg_cron job completion.
CRON_APP_BASE_URL=http://localhost:3000

# Article feeds use Realtime plus a five-minute visible-tab fallback.
NEXT_PUBLIC_REFRESH_EVERY_MINUTES=15

# Kiosk Mode / Raspberry Pi Deployment
NEXT_PUBLIC_KIOSK_MODE=false
HOST_AGENT_URL=http://localhost:9876
HOST_AGENT_SECRET=replace-with-host-agent-secret